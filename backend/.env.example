# Marketly backend environment

# Optional Redis cache. If unset or unavailable, the backend still runs.
REDIS_URL=

# Financial providers. /financials and /score need at least one usable provider.
FINNHUB_API_KEY=
FMP_API_KEY=
FMPSDK_API_KEY=
RAPIDAPI_KEY=
# SEC requires a descriptive user agent with a real contact address.
SEC_USER_AGENT=Marketly/1.0 (contact: your-real-email@example.com)

# Macro data for /economics and /score.
FRED_API_KEY=

# OpenAI analysis and scenario generation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano-2025-08-07

# Optional durable server-side cache. Use the service role key only on the backend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Durable market refresh loop (requires the background_market_refresh migration).
# Keep the backend running, or run python -m app.services.market_refresh in a worker.
BACKGROUND_REFRESH_ENABLED=true
