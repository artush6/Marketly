{
  "version": 1,
  "lineLength": 100,
  "indentation": {
    "spaces": 4
  },
  "maximumBlankLines": 1,
  "respectsExistingLineBreaks": false,
  "lineBreakAroundMultilineExpressionChainComponents": false,
  "rules": {
    "DoNotUseSemicolons": true,
    "OneVariableDeclarationPerLine": true,
    "OneCasePerLine": true,
    "OrderedImports": true,
    "NoEmptyLinesOpeningClosingBraces": true
  }
}
